[Unit]
Description=go-replay-analysis KataGo worker (exits when the queue is empty)
Wants=go-replay-lan.service
After=go-replay-lan.service

[Service]
# Analyses queued games and posts the results to the LAN app. ABSOLUTE RULE
# (owner, 2026-10-08): it runs only between 00:00 and 07:00, never outside,
# whatever an interrupted run or a queued game would otherwise want.
# go-replay-analyzer-start.timer starts it at 00:00, go-replay-analyzer-stop.timer
# stops it at 07:00, and ExecCondition below refuses any start (login, manual
# `systemctl --user start`, Restart=) when the hour is 07-23. It is not enabled
# at login. With --once it exits, freeing the GPU, when nothing is queued.
# Install: copy to ~/.config/systemd/user/, then
#   systemctl --user daemon-reload && systemctl --user enable --now go-replay-analyzer-start.timer go-replay-analyzer-stop.timer
WorkingDirectory=%h/proj/go-replay-analysis
# Exit 1 here means skipped, not failed: only hours 00-06 may run.
ExecCondition=/bin/sh -c '[ "$(date +%%H)" -lt 7 ]'
ExecStart=/usr/bin/node scripts/analyzer.mjs --server http://127.0.0.1:4517 --katago %h/katago/trt/katago-trt --model %h/katago/nets/b10c512h8nbt3tflrs-fson-silu-rsnh.bin.gz --once
Restart=on-failure
RestartSec=30
