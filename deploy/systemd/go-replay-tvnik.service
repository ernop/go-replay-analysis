[Unit]
Description=go-replay-analysis LAN app on tvnik (next dev, :4517)
After=network-online.target
Wants=network-online.target

[Service]
# tvnik only: system Node is 18, so PATH points at nvm's Node 22 first.
# Install: copy to ~/.config/systemd/user/, then
#   systemctl --user daemon-reload && systemctl --user enable --now go-replay-tvnik
# Dev mode on purpose: it picks up `git pull` without a rebuild.
WorkingDirectory=%h/proj/go-replay-analysis
Environment=PATH=%h/.nvm/versions/node/v22.23.3/bin:/usr/local/bin:/usr/bin:/bin
Environment=NEXT_TELEMETRY_DISABLED=1
ExecStart=%h/.nvm/versions/node/v22.23.3/bin/npm run dev
Restart=on-failure
RestartSec=5
KillMode=control-group

[Install]
WantedBy=default.target
